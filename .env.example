# Set these in the process environment. The server does not implicitly load .env.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cyberguard?sslmode=disable
APP_ADDRESS=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PUBLIC_REGISTRATION_ENABLED=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# Zero disables automatic report deletion. Positive values enable hourly cleanup.
RETENTION_DAYS=0
OPENAI_API_KEY=
OPENAI_MODEL=
MIGRATIONS_PATH=../migrations
# Optional isolated, migrated database for integration tests:
TEST_DATABASE_URL=
