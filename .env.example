# CyberGuard AI local configuration template.
# Copy to .env.local in the project root (scripts\setup.ps1 does this for you).
# The backend and CLI read .env.local as plain KEY=VALUE text: nothing is executed
# and nothing is expanded. Variables already set in the process take precedence.
# Never commit .env.local or share it.

# PostgreSQL connection. Percent-encode special characters in the password
# (for example @ becomes %40). scripts\setup-postgres.ps1 can write this for you.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cyberguard?sslmode=disable

# Address the backend listens on, and the exact address of the website.
# Open the site with exactly APP_ORIGIN (localhost and 127.0.0.1 are different origins).
APP_ADDRESS=127.0.0.1:8080
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# true lets people create an account on the sign-in page. For a private local
# installation set it to true, register, then set it back to false if other
# people can reach this computer.
PUBLIC_REGISTRATION_ENABLED=false

SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# 0 keeps reports forever. A positive number deletes older reports every hour.
RETENTION_DAYS=0

# Base64 of 32 random bytes. Encrypts the OpenAI and VirusTotal keys that users
# save in Settings. scripts\setup.ps1 creates it once. Keep it stable and back
# it up: if it changes, saved keys can no longer be decrypted and must be entered again.
PROVIDER_MASTER_KEY=

# Optional: an OpenAI key provided by the server operator for accounts that have
# not saved their own. Normally leave these empty; users add keys in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_OPERATOR_FALLBACK_ENABLED=false

# Optional endpoint overrides (gateway, or the local mock providers used for
# testing). Must be https, except http://localhost for local mocks.
OPENAI_BASE_URL=
VIRUSTOTAL_BASE_URL=

# VirusTotal request allowance kept by CyberGuard per user. The defaults match
# the Public API (4 per minute, 500 per day). Raise only for a licence that allows it.
VIRUSTOTAL_REQUESTS_PER_MINUTE=
VIRUSTOTAL_REQUESTS_PER_DAY=

# Optional comma-separated authserv-id values of YOUR receiving mail servers.
# Only the topmost Authentication-Results header from such a server is labelled
# "reported by your receiving server". Leave empty if unsure.
TRUSTED_AUTHSERV_IDS=

MIGRATIONS_PATH=../migrations

# Optional isolated database for integration tests. Must be named cyberguard_test.
TEST_DATABASE_URL=
